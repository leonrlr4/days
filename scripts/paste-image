#!/usr/bin/env bash
# Import an image into the Days store and report it as JSON.
#
#   paste-image --dir <data dir> [--file <path>]
#
# With --file the image comes from that path; without it, from the Wayland
# clipboard. A copied file *path* counts as an image too, which is how a
# screenshot dragged out of a file manager gets in.
#
# This is the only subprocess the plugin spawns during normal use. Every other
# path -- opening, changing day, checking a box, typing -- stays inside QML.
#
# stdout is always a single JSON object, on failure as much as on success:
# the caller parses it and has no other channel to learn what happened.
set -uo pipefail

# A fixed PATH, not whatever the caller happened to export. Every tool below is
# resolved from it, so a writable directory earlier in someone's PATH cannot
# stand in for magick, jq or cp. Omarchy's own commands live outside it and are
# added explicitly.
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/share/omarchy/bin"

die() { jq -cn --arg e "$1" '{ok: false, error: $e}'; exit 0; }

# The clipboard is not a trusted size. A gigapixel image is a few hundred bytes
# on disk -- that is what a decompression bomb is -- so the byte count and the
# decoded dimensions are both bounded before anything decodes. Overridable so
# the tests can use values small enough to trip deliberately.
MAX_BYTES=${DAYS_MAX_BYTES:-67108864}      # 64 MiB on disk
MAX_PIXELS=${DAYS_MAX_PIXELS:-50000000}    # 50 megapixels decoded

# Ceilings for ImageMagick itself, so a format that lies about its dimensions
# still cannot run the machine out of memory or time. These go after the
# subcommand: `magick -limit ... identify` reads "identify" as a filename.
LIMITS=(-limit memory 256MiB -limit map 512MiB -limit disk 1GiB -limit time 30)

DIR=""
FILE=""

# shift 2 does nothing when only the flag is left, so the loop would spin on
# the same argument forever.
need_value() { (($# >= 2)) || die "$1 needs a value"; }

while (($#)); do
  case "$1" in
    --dir) need_value "$@"; DIR="$2"; shift 2 ;;
    --file) need_value "$@"; FILE="$2"; shift 2 ;;
    *) die "unknown argument: $1" ;;
  esac
done
[[ -n "$DIR" ]] || die "no --dir given"

for tool in magick sha256sum jq; do
  command -v "$tool" >/dev/null || die "$tool is not installed"
done

TMP=$(mktemp -d) || die "could not create a temporary directory"
trap 'rm -rf "$TMP"' EXIT
SRC="$TMP/src"

if [[ -n "$FILE" ]]; then
  [[ -f "$FILE" ]] || die "no such file: $FILE"
  # Bounded at the read, not after it: $SRC lives in /tmp, which is RAM here,
  # so copying first and measuring second means a huge input is already
  # resident before anything rejects it. One byte past the ceiling is enough
  # to know it is over.
  head -c $((MAX_BYTES + 1)) -- "$FILE" > "$SRC" || die "could not read $FILE"
else
  command -v wl-paste >/dev/null || die "wl-clipboard is not installed"
  # Take the clipboard's own image type when it offers one. Asking for a type
  # it does not hold makes wl-paste convert, and the conversion is lossier
  # than whatever it already has.
  mime=$(wl-paste --list-types 2>/dev/null | grep -m1 '^image/') || mime=""
  if [[ -n "$mime" ]]; then
    wl-paste --no-newline --type "$mime" 2>/dev/null |
      head -c $((MAX_BYTES + 1)) > "$SRC" || die "could not read the clipboard"
  else
    # Fall back to a copied path, trimmed of the file:// a file manager adds.
    path=$(wl-paste --no-newline 2>/dev/null | head -1)
    path=${path#file://}
    path=$(printf '%b' "${path//%/\\x}")
    [[ -n "$path" && -f "$path" ]] || die "the clipboard holds no image"
    head -c $((MAX_BYTES + 1)) -- "$path" > "$SRC" || die "could not read $path"
  fi
fi

[[ -s "$SRC" ]] || die "the clipboard holds no image"

bytes=$(stat -c%s "$SRC")
(( bytes <= MAX_BYTES )) || die "image is too large: $bytes bytes (limit $MAX_BYTES)"

# identify is the arbiter of whether these bytes are an image at all -- the
# name they arrived under proves nothing.
# identify reads the header rather than the pixels, so the dimensions are known
# before anything is decoded -- which is the only order in which a pixel ceiling
# is worth having.
read -r format width height < <(magick identify "${LIMITS[@]}" -format '%m %w %h\n' "$SRC" 2>/dev/null | head -1)
[[ -n "${format:-}" && -n "${width:-}" && -n "${height:-}" ]] || die "not an image"
[[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] || die "not an image"
(( width * height <= MAX_PIXELS )) || die "image is too large to decode: ${width}x${height} (limit $MAX_PIXELS pixels)"

case "$format" in
  PNG) ext=png ;;
  JPEG|JPG) ext=jpg ;;
  WEBP) ext=webp ;;
  GIF) ext=gif ;;
  AVIF) ext=avif ;;
  *) die "unsupported image format: $format" ;;
esac

sha=$(sha256sum "$SRC" | cut -d' ' -f1)
blob="$DIR/blobs/$sha.$ext"
thumb="$DIR/thumbs/$sha.webp"
mkdir -p "$DIR/blobs" "$DIR/thumbs" || die "could not write to $DIR"

# Staging files are named without a leading dot so the collector's glob can see
# them: a kill between mktemp and mv would otherwise leave a full-size copy of
# the image that no sweep could ever reclaim.
#
# The hash is derived from the image, so every path written below is
# predictable by whoever supplies it. Staging through mktemp -- which creates
# exclusively, never following an existing link -- and renaming into place
# keeps that from mattering: rename replaces a symlink rather than writing
# through it, and the move is atomic, so a reader never sees a blob whose bytes
# do not hash to its name.
deduped=true
if [[ ! -f "$blob" || -L "$blob" ]]; then
  deduped=false
  staged=$(mktemp "$DIR/blobs/staging.XXXXXXXX") || die "could not stage the image"
  cp -- "$SRC" "$staged" && mv -f -- "$staged" "$blob" || {
    rm -f -- "$staged"
    die "could not store the image"
  }
fi

if [[ ! -f "$thumb" || -L "$thumb" ]]; then
  # 320 on the long edge, shrink-only. Lists load nothing but these, so the
  # bound is the reason they stay cheap to render.
  staged=$(mktemp "$DIR/thumbs/staging.XXXXXXXX") || die "could not stage the thumbnail"
  magick "${LIMITS[@]}" "$SRC[0]" -auto-orient -resize '320x320>' -quality 82 "webp:$staged" 2>/dev/null &&
    mv -f -- "$staged" "$thumb" || {
      rm -f -- "$staged"
      die "could not render a thumbnail"
    }
fi

jq -cn \
  --arg sha "$sha" --arg ext "$ext" \
  --argjson w "$width" --argjson h "$height" \
  --argjson bytes "$(stat -c%s "$blob")" \
  --argjson deduped "$deduped" \
  '{ok: true, sha: $sha, ext: $ext, w: $w, h: $h, bytes: $bytes, deduped: $deduped}'
