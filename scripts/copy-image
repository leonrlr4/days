#!/usr/bin/bash
# Put one stored image on the clipboard.
#
#   copy-image --dir <data dir> --sha <hash> --ext <png|jpg|webp|gif|avif>
#
# The hash and extension come from a day file, which is the plugin's own data
# rather than anything a stranger wrote -- but they are still assembled into a
# path, so they are checked against their grammar before they get near one.
set -uo pipefail

# A fixed PATH, not whatever the caller happened to export.
export PATH="/usr/local/bin:/usr/bin:/bin"

die() { jq -cn --arg e "$1" '{ok: false, error: $e}'; exit 0; }

MAX_BYTES=${DAYS_MAX_BYTES:-67108864}

DIR=""
SHA=""
EXT=""

# shift 2 does nothing when only the flag is left, so the loop would spin.
need_value() { (($# >= 2)) || die "$1 needs a value"; }

while (($#)); do
  case "$1" in
    --dir) need_value "$@"; DIR="$2"; shift 2 ;;
    --sha) need_value "$@"; SHA="$2"; shift 2 ;;
    --ext) need_value "$@"; EXT="$2"; shift 2 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ -n "$DIR" ]] || die "no --dir given"
[[ "$SHA" =~ ^[0-9a-f]{64}$ ]] || die "not a content hash: $SHA"

case "$EXT" in
  png)  mime=image/png ;;
  jpg)  mime=image/jpeg ;;
  webp) mime=image/webp ;;
  gif)  mime=image/gif ;;
  avif) mime=image/avif ;;
  *) die "unsupported image type: $EXT" ;;
esac

blob="$DIR/blobs/$SHA.$EXT"
[[ -e "$blob" && ! -L "$blob" ]] || die "no stored image for that hash"

# Opened once, and everything after this reads through that descriptor rather
# than the name. Testing the path and then reopening it leaves a window in
# which the file can be replaced -- with a symlink to something else readable,
# whose bytes would then go on the clipboard.
#
# What binds the identity is the hash: blobs are content-addressed, so the name
# is a claim about the bytes, and checking the bytes behind the descriptor that
# will actually be read proves the claim. /proc/self/fd/N reopens the same
# inode, so neither read can be diverted while the descriptor is held.
exec {blobfd}< "$blob" || die "could not open the stored image"
held="/proc/self/fd/$blobfd"
[[ -f "$held" ]] || { exec {blobfd}<&-; die "no stored image for that hash"; }

# Read once, into something nobody else can reach.
#
# Holding the descriptor stops the *name* being swapped, but the inode behind
# it stays writable: hashing through it and then letting wl-copy read it again
# is two reads of mutable storage, and the bytes can change in between. So the
# bytes are copied once into a temporary that is unlinked immediately -- after
# that no path leads to it at all, and the only references are the descriptors
# opened here. The digest is taken from that buffer and the clipboard is fed
# from that same buffer, so what was verified is exactly what is delivered.
buffer=$(mktemp) || { exec {blobfd}<&-; die "could not stage the image"; }
exec {wfd}> "$buffer" || { rm -f -- "$buffer"; exec {blobfd}<&-; die "could not stage the image"; }
exec {hashfd}< "$buffer" || { rm -f -- "$buffer"; exec {blobfd}<&-; die "could not stage the image"; }
exec {sendfd}< "$buffer" || { rm -f -- "$buffer"; exec {blobfd}<&-; die "could not stage the image"; }
rm -f -- "$buffer"

# Bounded on the way in: a blob can have grown since it was stored, and this
# buffer is memory-backed.
head -c $((MAX_BYTES + 1)) < "$held" >&$wfd
exec {wfd}>&- {blobfd}<&-

actual=$(sha256sum <&$hashfd | cut -d' ' -f1)
exec {hashfd}<&-
if [[ "$actual" != "$SHA" ]]; then
  exec {sendfd}<&-
  die "stored image does not match its hash -- refusing to copy"
fi

command -v wl-copy >/dev/null || { exec {sendfd}<&-; die "wl-clipboard is not installed"; }

# wl-copy forks and holds the selection until something else claims it; that
# background process is the clipboard, so it is not waited on.
wl-copy --type "$mime" <&$sendfd || { exec {sendfd}<&-; die "could not reach the clipboard"; }
exec {sendfd}<&-

jq -cn --arg sha "$SHA" --arg mime "$mime" '{ok: true, sha: $sha, mime: $mime}'
