#!/usr/bin/env bash
# Run the head-less suites.
#
#   tests/run
#
# QT_ASSUME_STDERR_HAS_CONSOLE is what makes console output visible: under
# -platform offscreen Qt installs a message handler that drops it silently,
# so without this a failing check prints nothing and only the exit code moves.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
fail=0
TZ=Asia/Taipei QT_ASSUME_STDERR_HAS_CONSOLE=1 /usr/lib/qt6/bin/qml -platform offscreen tests/test_store.qml 2>&1 || fail=1
rm -rf "${XDG_RUNTIME_DIR:-/tmp}/days-fileview-test"
# Piping would hide quickshell's exit code behind grep's, and grep succeeds on
# the word FAIL -- so the status is captured before anything filters the output.
out=$(QT_ASSUME_STDERR_HAS_CONSOLE=1 quickshell -p tests/test_qml.qml 2>&1) || fail=1
grep -E 'FAIL|ok ' <<<"$out" | sed 's/\x1b\[[0-9;]*m//g'

bash tests/test_paste.sh || fail=1
bash tests/test_gc.sh || fail=1
bash tests/test_setup.sh || fail=1
bash tests/test_copy.sh || fail=1

exit $fail
